#!/bin/bash
# Type II: install the two SHA-256-verified wheels of a sealed build into a clean
# venv on a full GB200 and run the device checks and the cuDSS/BFV pytest files.
#   qsub -q t2-share -l gpu=1 -W depend=afterany:<last build link> -v JOB_ROOT=<root>,RUN=validate-1,BUILD=build-1 validate.pbs
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -r n
set -Eeuo pipefail
umask 077
: "${JOB_ROOT:?}" "${RUN:?}" "${BUILD:?}"
expect_name=${EXPECT_GPU_NAME:-GB200}
expect_cc=${EXPECT_GPU_CC:-10.0}
threads=${OMP_THREADS_FLOW2:-8}
cuda=${CUDA_HOME_FLOW2:-/home/center/opt/aarch64/cores/cuda/12.8}
nvpl=${NVPL_LIB_FLOW2:-/home/center/opt/aarch64/cores/nvhpc/26.5/Linux_aarch64/26.5/math_libs/nvpl/lib}
run=$JOB_ROOT/$RUN
mkdir "$run"
cd "$run"
exec >run.log 2>&1
phase=allocation
trap 'rc=$?; printf "phase=%s\nexit_code=%s\n" "$phase" "$rc" > terminal.txt' EXIT
test "$(uname -m)" = aarch64
python3.12 -c 'import json,os,socket,sys; json.dump({"run":sys.argv[1],"pbs_jobid":os.environ["PBS_JOBID"],"node":socket.gethostname()},open("job.json","w"),indent=2)' "$RUN"
qstat -f "$PBS_JOBID" | sed '/^[[:space:]]*Variable_List = /,$d' > allocation.txt
(cd "$JOB_ROOT" && sha256sum --quiet -c inputs.sha256)
b=$JOB_ROOT/$BUILD
test -e "$b/sealed.txt"
grep -qx 'phase=complete' "$b/terminal.txt"
grep -qx 'exit_code=0' "$b/terminal.txt"
(cd "$b/out/wheelhouse" && sha256sum -c ../../wheel.sha256) > wheel-verify.txt
python3.12 "$JOB_ROOT/source/tools/flow2/summarize.py" identity "$BUILD" "$b" > validated-wheels.json
python3.12 - "$JOB_ROOT/owner.json" <<'PY'
import datetime, json, sys
deadline = datetime.datetime.fromisoformat(json.load(open(sys.argv[1]))["deadline_utc"])
assert datetime.datetime.now(datetime.timezone.utc) < deadline, "past the owner.json deadline"
PY
cpus=$(python3.12 -c 'import os,sys; a=sorted(os.sched_getaffinity(0)); n=int(sys.argv[1]); assert len(a)>=n; print(",".join(map(str,a[:n])))' "$threads")
taskset -pc "$cpus" $$ > affinity.txt
export OMP_NUM_THREADS=$threads PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
export LD_LIBRARY_PATH="$nvpl"   # site NVPL; the CUDA runtime comes from the pinned wheels
unset PYTHONPATH
phase=environment
python3.12 -m venv venv
export PATH="$run/venv/bin:$PATH"
python -m pip install -q --no-index --require-hashes --find-links "$JOB_ROOT/wheelhouse-validate" \
  -r "$JOB_ROOT/source/tools/flow2/requirements-validate-aarch64.txt"
python -m pip install -q --no-index --no-deps "$b"/out/wheelhouse/*.whl
python -m pip check > pip-check.txt
python -m pip freeze > freeze.txt
phase=import
cd "$run"   # never import from the checkout
# ngscuda prints a device query on stdout: write the record to the file directly
python -I -c 'import json, sys, ngsolve, netgen, ngsolve.ngscuda as c; json.dump({"ngsolve": ngsolve.__file__, "netgen": netgen.__file__, "version": ngsolve.__version__, "cudss": hasattr(c, "CuDSSCholesky")}, open(sys.argv[1], "w"))' import.json
python -I - "$JOB_ROOT" import.json <<'PY'
import json, sys
r = json.load(open(sys.argv[2]))
assert all(sys.argv[1] + "/source" not in r[k] and "/venv/" in r[k] for k in ("ngsolve", "netgen")), r
assert r["cudss"], r
PY
python -I -c 'import netgen.occ as o; b = o.Box(o.Pnt(0,0,0), o.Pnt(1,2,3)); assert abs(b.mass - 6) < 1e-12, b.mass; print("occ box volume", b.mass)' > occ.txt
phase=device
nvidia-smi --query-gpu=name,compute_cap,driver_version --format=csv,noheader > gpu.txt
test "$(wc -l < gpu.txt)" -eq 1
grep -q "$expect_name" gpu.txt
grep -q ", $expect_cc," gpu.txt
python -I "$JOB_ROOT/source/tools/flow2/gpu_smoke.py" gpu-smoke.json
phase=pytest
src=$JOB_ROOT/source/tests/pytest
python -I -m pytest -v -rs -p no:cacheprovider "$src/test_cudss_cholesky.py" --junitxml pytest-cudss.xml > pytest-cudss.log 2>&1
python -I -m pytest -v -p no:cacheprovider "$src/test_bfv_deformation.py" --junitxml pytest-bfv.xml > pytest-bfv.log 2>&1
python -I - <<'PY'
import xml.etree.ElementTree as E
for f, n in (("pytest-cudss.xml", 18), ("pytest-bfv.xml", 6)):
    s = E.parse(f).getroot()
    s = s if s.tag == "testsuite" else s.find("testsuite")
    got = {k: int(s.get(k)) for k in ("tests", "failures", "errors", "skipped")}
    assert got == {"tests": n, "failures": 0, "errors": 0, "skipped": 0}, (f, got)
PY
sha256sum validated-wheels.json wheel-verify.txt import.json occ.txt gpu.txt gpu-smoke.json pip-check.txt freeze.txt \
  pytest-cudss.xml pytest-bfv.xml pytest-cudss.log pytest-bfv.log allocation.txt > evidence.sha256
phase=complete
